# PostgreSQL Database Configuration
POSTGRES_DB=network_monitoring
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Application User (Non-Superuser for least privilege - Gate D2)
APP_DB_USER=app_user
APP_DB_PASSWORD=change_me_app_password

# Dashboard Reader (Column-level read-only for Observability UI)
DASHBOARD_DB_USER=dashboard_reader
DASHBOARD_DB_PASSWORD=change_me_dashboard_password
